# Database — local PostgreSQL (psycopg 3 + pool). No Supabase project needed.
# Example: postgresql://postgres:<password>@localhost:5432/gaia_dev
# Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gaia_dev

# Document storage — local filesystem (files stay out of Git).
LOCAL_STORAGE_DIR=data/uploads

# Supabase Auth compatibility (JWT verification only — standalone PyJWT,
# no Supabase database/storage/hosted-auth dependency).
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth / JWT
# From Supabase dashboard → Settings → API → JWT Secret
AUTH_JWT_SECRET=your-supabase-jwt-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_AUDIENCE=authenticated

# App
APP_NAME=SIH 26130 Gujarat MVP
DEBUG=false

# CORS — comma-separated frontend origin allowlist (no wildcards with credentials)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
