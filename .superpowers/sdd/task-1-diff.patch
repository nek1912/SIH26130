+        "DISH": "A07",
+        "BOCW": "A08",
+        "HT Electricity": "A09",
+        "CEICED": "A10",
+        "IFP": "A10",
+        "HOWM": "A11",
+        "MSIHC": "A12",
+        "Chemical Accidents": "A13",
+        "BU Permission": "A14",
+        "Lift": "A15",
+        "Boiler": "A16",
+        "PESO": "A17",
+        "CGWA": "A18",
+    }
+    result: set[str] = set()
+    for keyword, aid in mapping.items():
+        if keyword in used_for:
+            result.add(aid)
+    return sorted(result)
